# Copy to .env on the server. Never commit .env or paste keys in chat.
THREAD_APP_USERNAME=admin
# Required for Docker; use a unique password with at least 12 characters.
THREAD_APP_PASSWORD=
# OpenAI API key, billed separately from a ChatGPT subscription.
THREAD_OPENAI_KEY=
THREAD_OPENAI_MODEL=gpt-4.1-mini
THREAD_PORT=8000
# Needed only for compose.https.yaml, after pointing DNS to your server.
THREAD_DOMAIN=
